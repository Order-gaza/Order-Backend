APP_NAME="Order"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# -------------------------------------------------------------------
# DATABASE - Fill these from Hostinger cPanel > MySQL Databases
# -------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_username_orderdb
DB_USERNAME=your_cpanel_username_orderuser
DB_PASSWORD=YourStrongPasswordHere

# -------------------------------------------------------------------
# EMAIL / SMTP - Hostinger Business Email
# Replace with your actual Hostinger email credentials
# How to find these: Hostinger hPanel > Emails > Manage > SMTP settings
# -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=YourEmailPasswordHere
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Order App"

# -------------------------------------------------------------------
# QUEUE - Use database driver on shared hosting (no Redis)
# -------------------------------------------------------------------
QUEUE_CONNECTION=database

# -------------------------------------------------------------------
# CACHE - Use file driver on shared hosting
# -------------------------------------------------------------------
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -------------------------------------------------------------------
# STORAGE - Hostinger file storage path
# -------------------------------------------------------------------
FILESYSTEM_DISK=local

# -------------------------------------------------------------------
# SANCTUM - Token expiry in minutes (30 days)
# -------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SANCTUM_TOKEN_EXPIRATION=43200

# -------------------------------------------------------------------
# FCM - Firebase Cloud Messaging (Push Notifications)
# Get this from Firebase Console > Project Settings > Cloud Messaging
# -------------------------------------------------------------------
FCM_SERVER_KEY=your_firebase_server_key_here

# -------------------------------------------------------------------
# APP SETTINGS
# -------------------------------------------------------------------
# How many days until flat fee model switches to percentage
FEE_MODEL_SWITCH_DAYS=60
